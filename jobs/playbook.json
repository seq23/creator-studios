  "_contract": {
    "what": "The clip-type library and the research playbook (owner's studio fix, 23 Oct 2026). One file, read by the planner (jobs/clipmaker.py plan_typed) AND the critic (jobs/clipmaker.py score_clip): each clip type's opening, length, pacing, ending and loop are the template a clip is planned from and scored against. A studio's niche_playbook (spec.niche_playbook, from the weekly niche research) is merged on top (jobs/playbook.py load). Business-neutral: no service words; every service word comes from a studio's settings.",
    "stages": "arrival = the space or subject before anything is done | prep = materials laid out, unloading, getting ready | team = people doing the work on camera | process = the work happening, no one in focus | finished = the finished result | detail = a close-up of the finished result | hero = the single most polished, steady, finished view of an event (a clip ENDS here, held >= 2 s)",
    "opening": "the stages the first shot may be (payoff first: flash the finished result in the first 1-2 s)",
    "length_s": "[min, max] seconds for the whole clip",
    "pacing_s": "[before_reveal, after_reveal] seconds per cut: fast before the reveal, slower after",
    "middle": "the stages the middle shots are drawn from, in story order",
    "ending": "always hero, held >= hero_hold_s",
    "loop": "true = the last frame matches the first (the payoff flash), so the clip loops cleanly",
    "needs": "what the footage must have for this type to be made"
  },
