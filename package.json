{
  "name": "creator-studios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creator Studios: one codebase deployed as separate creator studios (own Worker, D1 and R2 each). Dump footage, review clips, schedule through Buffer, find brand deals.",
  "scripts": {
    "dev": "wrangler dev",
    "dev:app": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate.mjs",
    "validate:looks": "node scripts/validate.mjs looks",
    "check": "npm run typecheck && npm run test && npm run validate && npm run build && node scripts/bundle-scan.mjs",
    "e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply creator-studios-dev-db --local",
    "help:screenshots": "HELP_SHOTS=1 playwright test tests/e2e/help-screenshots.spec.ts",
    "studio:gen": "node scripts/studio.mjs gen",
    "studio:create": "node scripts/studio.mjs create",
    "studio:deploy": "node scripts/studio.mjs deploy",
    "studio:secrets": "node scripts/studio.mjs secrets",
    "studio:invite": "node scripts/studio.mjs invite",
    "deploy:all": "node scripts/studio.mjs deploy --all"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=22"
  }
}
