:\"2rem\",\"--text-wordmark-lg\":\"clamp(2.75rem, 2rem + 2.3vw, 3.75rem)\",\"--wordmark-tracking\":\"0\"},\"dark\":{\"--bg\":\"#1c1714\",\"--surface\":\"#26201c\",\"--surface-2\":\"#2e2722\",\"--surface-sunk\":\"#16120f\",\"--text\":\"#efe6dc\",\"--text-soft\":\"rgba(239, 230, 220, 0.82)\",\"--text-muted\":\"#b5a79b\",\"--line\":\"rgba(239, 230, 220, 0.12)\",\"--line-strong\":\"rgba(239, 230, 220, 0.3)\",\"--primary\":\"#e39a7c\",\"--primary-text\":\"#1c1714\",\"--gold-ink\":\"#e39a7c\",\"--gold-soft\":\"rgba(227, 154, 124, 0.3)\",\"--gold-faint\":\"rgba(227, 154, 124, 0.12)\",\"--focus-color\":\"#e39a7c\",\"--glass\":\"rgba(38, 32, 28, 0.92)\",\"--login-bg\":\"radial-gradient(circle at 12% 0%, rgba(201, 143, 138, 0.16), transparent 34%), linear-gradient(160deg, #26201c, #1c1714)\"},\"wordmark\":{\"name\":\"Porch & Party\",\"tag\":\"studio\"}}",
