        "AUDIENCE_TIMEZONE": "America/Chicago",
        "PHOTO_POSTS": "{\"_why\":\"Photo posts (shared/photoPosts.ts): one photo becomes a pack of posts that go out on their own with a heads-up and a Skip. On by the host's word, 22 Oct 2026.\",\"on\":true,\"platforms\":[\"facebook\",\"instagram\",\"tiktok\",\"pinterest\"],\"headsUpHours\":24,\"postHour\":11}",
        "CONTENT_RULES": "{\"_why\":\"Porch & Party's rules, enforced in code (shared/contentRules.ts): never the word insured, no customer address or house number, prices only from this one list. Host's word, 22 Oct 2026. Faces: owner's ruling 24 Oct 2026, \\\"None of the porch and party videos [are] of customers so no face blur needed\\\": blockFaces false (no face is blurred and no clip is held for a face); house numbers are still blurred (blockAddresses, jobs/protect.py). Pinned by tests/unit/content-rules.test.ts.\",\"banWords\":[\"insured\"],\"blockAddresses\":true,\"blockFaces\":false,\"prices\":[{\"name\":\"Grand Holiday Porch\",\"usd\":1050}],\"ownerFace\":\"show\"}",
        "STUDIO_SOUND": "{\"cameraSound\":\"off\",\"voice\":{\"source\":\"stock\",\"stock\":\"af_heart\"}}",
        "STUDIO_RULES": "{\"cta_phrases\":[\"Book your date\",\"Request a quote\",\"Get in touch with us\"],\"cta_link\":\"https://porchandparty901.com/request\",\"ai_note\":\"all\",\"clip_target\":{\"min\":15,\"max\":30},\"bar\":70,\"place_words\":[\"Memphis\",\"Germantown\",\"Collierville\",\"Bartlett\"],\"prices\":false}",
        "AUTO_REDO_FROM": "",
        "STUDIO_AI_BUDGET": "3500",
        "SPONSOR_KIND": "event",
        "WHATS_NEW": "{\"id\":\"2026-10-photo-posts\",\"title\":\"New in your studio\",\"lines\":[\"Add a photo and the studio makes a few posts from it.\",\"Posts go to Facebook, Instagram, TikTok and Pinterest on their own.\",\"You get an email the day before. Tap Skip to stop one.\",\"Faces and house numbers are blurred before anything posts.\"]}",
        "ENV_NAME": "production",
        "AUTH_MODE": "code"
      }
    },
