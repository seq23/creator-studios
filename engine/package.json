{
  "name": "creator-studios-engine",
  "private": true,
  "type": "module",
  "description": "The content engine: proven short-form formats rendered on the host's Mac (Remotion), reviewed on real frames, then queued into a studio's photo posts. README.md.",
  "scripts": {
