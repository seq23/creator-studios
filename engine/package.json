    "studio": "remotion studio src/index.ts",
    "render": "node render.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
