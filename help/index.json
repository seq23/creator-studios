{
  "_contract": {
    "guide_file": "help/guides/<slug>.md, one task, 3-8 steps, each '## ' heading is one step; '## Did this work?' closes it",
    "frontmatter": {
      "title": "required, plain words",
      "group": "required: getting_started | everyday | brand_deals | fix_it (must match this index)",
      "screen": "required: a key of SCREEN_ROUTES in app/lib/markdown.ts (home, dump, review, calendar, brain, research, stats, voice, settings, connect, deals, mediakit, help, login)",
      "keywords": "optional: comma-separated words and phrases she might search for (\"how do i post\")",
      "last_checked": "required: YYYY-MM-DD the steps were last walked",
      "target": "optional: CSS or Playwright selector (e.g. role=button[name=\"Dump\"]) the screenshot job circles on every step",
      "fix": "optional: slug of the fix-it guide that 'No, show me a fix' opens; without it, No emails the helper"
    },
    "per_step_comments": {
      "<!-- target: selector -->": "circle this element for this step (overrides frontmatter target); the job fails if it is not on screen",
      "<!-- route: /path -->": "open this route for this step (default: the guide's screen)",
      "<!-- click: selector -->": "click this first (e.g. open a card), then take the shot; several run in order",
      "<!-- fill: selector => text -->": "type this into a field first",
      "<!-- api: METHOD /api/path {json} -->": "put the app in the state the step describes through its own API (e.g. a refused key)",
      "<!-- light: Name | red | note -->": "set one health light for this step",
      "<!-- mock: name -->": "a step on another site or app: a labelled illustration from tests/e2e/help-mocks.ts, never a real account",
      "<!-- shared -->": "this picture is deliberately identical to another step's (otherwise the job and the validator refuse duplicates)"
    },
    "images": "![Step n](/help/screenshots/<slug>-<n>.png); the job writes <slug>-<n>.png (desktop 1280x820) and <slug>-<n>-phone.png (390x844) from tests/e2e/help-screenshots.spec.ts with demo data only"
  },
